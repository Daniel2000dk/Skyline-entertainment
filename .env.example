# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these per environment (Preview and Production use
# DIFFERENT Supabase projects and secrets).

# Supabase project (Dashboard → Project Settings → API Keys). Server-only:
# none of these use NEXT_PUBLIC_, so they never reach the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Random secret (min. 32 chars) for hashing rate-limit keys.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SECRET=

# Public origin of this deployment, used in invite and reset links.
# Optional on Vercel (derived automatically); required elsewhere.
SITE_URL=http://localhost:3000
